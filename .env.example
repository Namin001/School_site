# Database connection URL (e.g., file:./dev.db for local SQLite, or your hosted PostgreSQL/MySQL connection string)
DATABASE_URL="file:./dev.db"

# Secret key used for signing JWT session tokens (always change this in production!)
JWT_SECRET="your-jwt-secret-key-here"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here"

